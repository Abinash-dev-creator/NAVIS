# Navis v0.1 configuration
# "ollama" for local AI, or "cloud" for an OpenAI-compatible API.
NAVIS_PROVIDER=ollama

# Local Ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional cloud provider (only used when NAVIS_PROVIDER=cloud)
# Example base URL: https://api.openai.com/v1
CLOUD_BASE_URL=https://api.openai.com/v1
CLOUD_API_KEY=
CLOUD_MODEL=

# Local app settings
NAVIS_DB_PATH=./data/navis.db
NAVIS_MAX_HISTORY_MESSAGES=24
